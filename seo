def generate_fixes(url, issue_type=None, output_file=None, generate_html=False):
    """Generate AI-powered fixes using MiMo"""
    print_banner()
    
    if not ANTHROPIC_AVAILABLE:
        print("✗ anthropic package not installed")
        print("  Run: pip install -r requirements.txt")
        return None
    
    mimo_key = os.getenv("MIMO_API_KEY")
    if not mimo_key:
        print("✗ MIMO_API_KEY not set")
        print("  Run: cp .env.example .env && nano .env")
        return None
    
    print(f"🤖 Generating MiMo-powered fixes for: {url}")
    print()
    
    # Default issues to fix
    issues = [
        {"type": "missing_meta_description", "affected_url": url, "title": "Missing meta description"},
        {"type": "short_title", "affected_url": url, "title": "Title too short"},
    ]
    
    if issue_type:
        issues = [i for i in issues if i["type"] == issue_type]
    
    fixes = []
    for issue in issues:
        print(f"  🔧 Fixing: {issue['title']}")
        fix = generate_mimo_fix(url, issue["type"])
        if fix:
            fix_data = {
                "source": "mimo",
                "type": issue["type"],
                "url": url,
                "issue_title": issue["title"],
                "suggestion": fix,
                "fix": fix,
                "priority": "medium"
            }
            fixes.append(fix_data)
            print(f"    ✓ Generated (source: mimo)")
        else:
            print(f"    ✗ Failed to generate fix")
    
    print()
    print("📋 Generated Fixes:")
    for fix in fixes:
        print(f"  - {fix['type']}: {fix['suggestion'][:100]}...")
    
    # Save to file if requested
    if output_file:
        with open(output_file, "w") as f:
            json.dump(fixes, f, indent=2)
        print()
        print(f"📄 Fixes saved to: {output_file}")
    
    return fixes


def apply_fixes_to_wordpress(url):
    """Apply fixes to WordPress via REST API"""
    print_banner()
    
    # Check environment variables
    wp_url = os.getenv("WP_URL")
    wp_user = os.getenv("WP_USER")
    wp_pass = os.getenv("WP_PASS")
    
    if not all([wp_url, wp_user, wp_pass]):
        print("✗ WordPress credentials not set")
        print("  Run: cp .env.example .env && nano .env")
        return None
    
    print(f"📤 Applying fixes to WordPress: {wp_url}")
    print()
    
    # Get page ID from URL
    slug = url.split("/")[-1] if url.endswith("/") else url.split("/")[-1]
    if not slug:
        slug = "home"
    
    # Get page ID
    import requests
    response = requests.get(
        f"{wp_url}/wp-json/wp/v2/pages?slug={slug}",
        auth=(wp_user, wp_pass)
    )
    
    if response.status_code == 200:
        pages = response.json()
        if pages:
            page_id = pages[0]["id"]
            print(f"  Found page: {slug} (ID: {page_id})")
            
            # Generate fix
            fixes = generate_fixes(url)
            if fixes:
                # Apply title fix
                title_fix = next((f for f in fixes if f["type"] == "short_title"), None)
                if title_fix:
                    print(f"  Updating title: {title_fix['suggestion'][:50]}...")
                    # WordPress API call
                    update_response = requests.post(
                        f"{wp_url}/wp-json/wp/v2/pages/{page_id}",
                        auth=(wp_user, wp_pass),
                        json={"title": title_fix['suggestion']}
                    )
                    if update_response.status_code == 200:
                        print("  ✓ Title updated successfully")
                    else:
                        print(f"  ✗ Update failed: {update_response.status_code}")
        else:
            print(f"  Page not found: {slug}")
    else:
        print(f"  Error: {response.status_code}")


def main():
    parser = argparse.ArgumentParser(
        description="SEO-Autopilot Skill - MiMo-powered SEO analysis",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  seo test                              Test MiMo connection
  seo audit https://example.com         Run full SEO audit
  seo audit https://example.com --html  Generate HTML report
  seo fix https://example.com           Generate AI-powered fixes
  seo analyze https://example.com       Analyze single page
  seo apply https://example.com         Apply fixes to WordPress
        """
    )
    parser.add_argument("command", choices=["audit", "analyze", "fix", "test", "apply"], help="Command to run")
    parser.add_argument("url", nargs="?", help="URL to analyze")
    parser.add_argument("--type", help="Issue type to fix")
    parser.add_argument("--output", "-o", help="Output file path")
    parser.add_argument("--html", action="store_true", help="Generate HTML report")
    
    args = parser.parse_args()
    
    if args.command == "test":
        success = test_mimo_connection()
        sys.exit(0 if success else 1)
    
    elif args.command == "audit":
        if not args.url:
            print("Error: URL required for audit")
            sys.exit(1)
        audit_website(args.url, args.output, args.html)
    
    elif args.command == "analyze":
        if not args.url:
            print("Error: URL required for analyze")
            sys.exit(1)
        analyze_page(args.url)
    
    elif args.command == "fix":
        if not args.url:
            print("Error: URL required for fix")
            sys.exit(1)
        generate_fixes(args.url, args.type, args.output)
    
    elif args.command == "apply":
        if not args.url:
            print("Error: URL required for apply")
            sys.exit(1)
        apply_fixes_to_wordpress(args.url)


if __name__ == "__main__":
    main()
