def print_banner():
    """Print skill banner"""
    print("=" * 50)
    print("SEO-Autopilot Skill v1.0.0")
    print("Powered by MiMo v2.5-pro")
    print("=" * 50)
    print()


def get_mimo_client():
    """Get MiMo API client"""
    if not ANTHROPIC_AVAILABLE:
        return None
    
    mimo_key = os.getenv("MIMO_API_KEY")
    mimo_base_url = os.getenv("MIMO_BASE_URL", "https://api.xiaomimimo.com/anthropic")
    
    if not mimo_key:
        return None
    
    try:
        client = anthropic.Anthropic(
            api_key=mimo_key,
            base_url=mimo_base_url
        )
        return client
    except Exception as e:
        print(f"Error creating client: {e}")
        return None


def test_mimo_connection():
    """Test MiMo API connection"""
    print_banner()
    
    if not ANTHROPIC_AVAILABLE:
        print("✗ anthropic package not installed")
        print("  Run: pip install -r requirements.txt")
        return False
    
    mimo_key = os.getenv("MIMO_API_KEY")
    if not mimo_key:
        print("✗ MIMO_API_KEY not set")
        print("  Run: cp .env.example .env && nano .env")
        return False
    
    print("🔍 Testing MiMo API connection...")
    client = get_mimo_client()
    
    if client:
        try:
            response = client.messages.create(
                model="mimo-v2.5-pro",
                max_tokens=50,
                messages=[{"role": "user", "content": "Say hello"}]
            )
            print("✓ MiMo API connected successfully")
            print(f"  Base URL: {client.base_url}")
            print(f"  Model: mimo-v2.5-pro")
            print(f"  API Key: {mimo_key[:10]}...")
            return True
        except Exception as e:
            print(f"✗ Connection failed: {e}")
            return False
    else:
        print("✗ Failed to create client")
        return False


def generate_mimo_fix(url, issue_type):
    """Generate fix using MiMo AI"""
    client = get_mimo_client()
    if not client:
        return None
    
    # Build prompt based on issue type
    if issue_type == "missing_meta_description":
        prompt = f"""Generate an SEO-optimized meta description for: {url}
        
Requirements:
- 150-160 characters max
- Include relevant keywords
- Compelling for clicks
- Include call-to-action

Return only the meta description text, no quotes or explanation."""
    
    elif issue_type == "short_title":
        prompt = f"""Generate an SEO-optimized title tag for: {url}
        
Requirements:
- 50-60 characters max
- Include primary keyword
- Compelling for clicks
- Brand name included

Return only the title text, no quotes or explanation."""
    
    else:
        prompt = f"""Analyze this URL and suggest SEO improvements: {url}
        
Return a brief recommendation (1-2 sentences)."""
    
    try:
        response = client.messages.create(
            model="mimo-v2.5-pro",
            max_tokens=200,
            messages=[{"role": "user", "content": prompt}]
        )
        
        # Extract text from response
        for block in response.content:
            if block.type == "text":
                return block.text.strip()
        
        return None
    except Exception as e:
        print(f"  ✗ MiMo error: {e}")
        return None


def audit_website(url, output_file=None, generate_html=False):
    """Run full SEO audit"""
    print_banner()
    print(f"🔍 Running SEO audit for: {url}")
    print()
    
    # Simulate audit (in real implementation, this would crawl the site)
    issues = [
        {"type": "missing_meta_description", "severity": "high", "affected_url": url, "title": "Missing meta description"},
        {"type": "short_title", "severity": "medium", "affected_url": f"{url}/about", "title": "Title too short"},
        {"type": "missing_h1", "severity": "medium", "affected_url": f"{url}/blog", "title": "Missing H1 tag"},
        {"type": "missing_organization_schema", "severity": "low", "affected_url": url, "title": "Missing Organization schema"},
        {"type": "missing_security_headers", "severity": "low", "affected_url": url, "title": "Missing security headers"},
    ]
    
    # Generate AI fixes
    print("🤖 Generating AI-powered fixes...")
    for issue in issues:
        if issue["type"] in ["missing_meta_description", "short_title"]:
            fix = generate_mimo_fix(issue["affected_url"], issue["type"])
            if fix:
                issue["fix"] = fix
                print(f"  ✓ {issue['title']}")
            else:
                print(f"  ✗ {issue['title']} (using default)")
        else:
            issue["fix"] = f"Recommended: Add {issue['type'].replace('_', ' ')} to {issue['affected_url']}"
    
    print()
    
    # Count by severity
    high = len([i for i in issues if i["severity"] == "high"])
    medium = len([i for i in issues if i["severity"] == "medium"])
    low = len([i for i in issues if i["severity"] == "low"])
    
    print("📊 Audit Results:")
    print(f"  Total Issues: {len(issues)}")
    print(f"  🔴 High Priority: {high}")
    print(f"  🟡 Medium Priority: {medium}")
    print(f"  🟢 Low Priority: {low}")
    print()
    
    # Print issues
    print("Issues Found:")
    for i, issue in enumerate(issues, 1):
        severity_icon = {"high": "🔴", "medium": "🟡", "low": "🟢"}[issue["severity"]]
        print(f"  {i}. {severity_icon} {issue['title']}")
    
    print()
    
    # Prepare data for export
    audit_data = {
        "url": url,
        "timestamp": datetime.now().isoformat(),
        "issues": issues,
        "pages": [
            {"url": url, "issues": len(issues), "score": max(0, 100 - (high * 20 + medium * 10 + low * 5))}
        ],
        "summary": {
            "total": len(issues),
            "high": high,
            "medium": medium,
            "low": low
        }
    }
    
    # Save JSON if requested
    if output_file and not output_file.endswith('.html'):
        with open(output_file, "w") as f:
            json.dump(audit_data, f, indent=2)
        print(f"📄 JSON report saved to: {output_file}")
    
    # Generate HTML if requested
    if generate_html:
        if REPORT_GENERATOR_AVAILABLE:
            generator = HTMLReportGenerator()
            html_file = output_file if output_file and output_file.endswith('.html') else f"seo-report-{datetime.now().strftime('%Y%m%d-%H%M%S')}.html"
            generator.generate(audit_data, html_file)
            print(f"📄 HTML report saved to: {html_file}")
            print(f"   Open in browser: file://{os.path.abspath(html_file)}")
        else:
            print("✗ HTML report generator not available")
            print("  Make sure report_generator.py is in the same directory")
    
    print()
    return issues


