# SEO-Autopilot Environment Variables
# Copy this file to .env and fill in your credentials

# MiMo API Configuration
# Get your API key from: https://platform.xiaomimimo.com
MIMO_API_KEY=your-mimo-api-key-here
MIMO_BASE_URL=https://api.xiaomimimo.com/anthropic
MIMO_MODEL=mimo-v2.5-pro

# WordPress Configuration
# Get application password from: WordPress Admin → Users → Your Profile → Application Passwords
WP_URL=https://your-site.com
WP_USER=your-username
WP_PASS=your-application-password
